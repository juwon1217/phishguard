{
    "builds": [
        {
            "src": "functions/main.py",
            "use": "@vercel/python"
        },
        {
            "src": "my-kakao-demo/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "functions/main.py"
        },
        {
            "src": "/(.*)",
            "dest": "/my-kakao-demo/$1"
        }
    ]
}